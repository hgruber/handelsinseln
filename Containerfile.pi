# Die Handelsinseln – Laufzeit-Container für Raspberry Pi 64-bit (aarch64).
# Auf dem Pi selbst bauen (empfohlen, kein Emulator):
#   podman build -f Containerfile.pi -t localhost/handelsinseln:latest .
# Auf einem x86_64-Rechner mit qemu-user-static (langsam, aber gleiches Ergebnis):
#   podman build --platform linux/arm64 -f Containerfile.pi -t localhost/handelsinseln:pi .
# Das Image ist statisch gelinkt, enthält keine Shell und läuft nur auf arm64.
FROM --platform=linux/arm64 docker.io/library/rust:1-alpine AS build
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY rust/Cargo.toml rust/Cargo.lock ./
COPY rust/src ./src
# Statisches Linken nur für das Endprogramm (proc-macros der Abhängigkeiten bleiben dynamisch).
RUN cargo rustc --release --locked --bin handelsinseln -- -C target-feature=+crt-static \
 && mkdir -p /empty

FROM --platform=linux/arm64 scratch
ARG APP_VERSION=
WORKDIR /app
COPY --from=build /src/target/release/handelsinseln /app/handelsinseln
COPY package.json /app/package.json
COPY public /app/public
COPY shared /app/shared
COPY --from=build --chown=10001:10001 /empty /data
ENV APP_VERSION=$APP_VERSION \
    PORT=8080 \
    DATA_DIR=/data \
    LOG_LEVEL=info
USER 10001:10001
EXPOSE 8080 8443
VOLUME /data
HEALTHCHECK --interval=30s --timeout=3s CMD ["/app/handelsinseln", "--health"]
CMD ["/app/handelsinseln"]
