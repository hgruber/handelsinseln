# Die Handelsinseln – Quadlet-Vorlage für systemd/podman (nach /etc/containers/systemd/ kopieren, dann systemctl daemon-reload).
# TLS übernimmt ein Reverse-Proxy davor (HTTPS_PORT=0). Spielstand im Volume handelsinseln (/data/state.json).
[Unit]
Description=Die Handelsinseln (Browserspiel)
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/handelsinseln:latest
HostName=handelsinseln
# Ohne Reverse-Proxy im selben Podman-Netz stattdessen den Port veröffentlichen:
# PublishPort=8080:8080
Volume=handelsinseln:/data
Environment=TZ=Europe/Berlin
Environment=PORT=8080
Environment=HTTPS_PORT=0
Environment=MAX_GAMES=3

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
